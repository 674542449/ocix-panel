# OCIX 环境变量示例
# 正常情况下不用手写这个文件——运行 scripts/install.sh 会自动生成 .env。
# 手工部署时把本文件复制为 .env 再填值。.env 含密钥，已被 .gitignore 排除。

# ---- 必填 ----
# 会话签名密钥（openssl rand -hex 32）
OCIX_SESSION_SECRET=replace-with-a-long-random-string
# 面板管理员账号。改动密码并重启会重置回这里，这也是忘记密码时的找回方式。
OCIX_ADMIN_USER=admin
OCIX_ADMIN_PASSWORD=change-me-now

# ---- 访问方式：域名 与 IP+端口 二选一 ----
# 方式 A：域名 + 自动 HTTPS（配合 docker-compose.caddy.yml）
#OCIX_DOMAIN=panel.example.com
#OCIX_ACME_EMAIL=you@example.com
#OCIX_TRUST_PROXY=true

# 方式 B：IP + 端口 直连（配合 docker-compose.direct.yml）
#OCIX_PORT=8000
#OCIX_BIND=0.0.0.0
#OCIX_TRUST_PROXY=false

# ---- 可选，保持默认即可 ----
OCIX_TOKEN_TTL=1440
OCIX_LAUNCH_TIMEOUT=180
OCIX_WORKERS=16
OCIX_LOGIN_LIMIT=10
OCIX_API_LIMIT=120
# 仅当前后端不同源时需要，逗号分隔
OCIX_CORS_ORIGINS=
